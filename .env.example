# ============================================================
#  WealthIn.AI — environment configuration
#  Copy this file to `.env` and fill in the keys you have.
#  You ONLY need GEMINI_API_KEY to run the free demo.
# ============================================================

# --- LLM provider selection ---
# Primary provider used for the agent. Options: groq | gemini | anthropic | openai
LLM_PROVIDER=gemini
# Automatic fallback if the primary is rate-limited / unavailable. Options: gemini | groq | anthropic | openai | none
LLM_FALLBACK=none

# --- API keys (only fill what you use) ---
# REQUIRED for the free demo — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional fallback — get one free at https://console.groq.com/keys (if their login works for you)
GROQ_API_KEY=
# Optional (dev / best quality) — ~$5 free starter credit at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional
OPENAI_API_KEY=

# --- Model names per provider (sensible free-tier defaults) ---
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# --- App behaviour ---
# If true, the app returns a canned example when no LLM key is configured (keeps the demo alive).
DEMO_MODE=true
# Requests per minute per client IP (public-demo safety).
RATE_LIMIT_PER_MINUTE=15
# Max agent reasoning steps before it must answer (prevents runaway loops / cost).
MAX_AGENT_STEPS=6
# Directory of documents to index for the RAG tool.
DOCS_DIR=./data/docs
LOG_LEVEL=INFO
